# 复制本文件内容到:
#   Streamlit Cloud -> 你的 App -> Settings -> Secrets
# 本地运行则保存为 .streamlit/secrets.toml(已被 .gitignore 忽略,不会上传)

DEEPSEEK_API_KEY = "sk-替换成你的key"

[supabase]
# 在 Supabase 项目 -> Project Settings -> API 里找
url = "https://xxxxxxxxxxxx.supabase.co"
# 用 anon public key 即可(只存在服务端,不会发给浏览器)
key = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.替换成anonkey"
